# ==============================================================================
# Git Ignore - Micro-HSM (Utimaco Payment HSM & Spring Boot Microservice)
# ==============================================================================

# Compiled binaries and target directory
target/
*.class
 
*.war
*.ear

# Maven Wrapper runtime cache
.mvn/wrapper/maven-wrapper.jar

# IDE & Editor files
.idea/
*.iml
*.iws
*.ipr
.vscode/
.settings/
.project
.classpath
.factorypath

# OS metadata & temporary files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.log
*.tmp
*.bak
*.swp
*~

# Exported keys, runtime logs & secrets generated by container
docker/utimaco-sim/exported-keys/*
!docker/utimaco-sim/exported-keys/.gitkeep
exported-keys/*
!exported-keys/.gitkeep

# Volatile simulator runtime files created on container launch (preserve original factory images in libs)
docker/utimaco-sim/devices/
*.tmp
*.log

# Note: The binaries and initial flash files under libs/Software/Linux/ are REQUIRED
# by docker/utimaco-sim/Dockerfile to build the Utimaco Simulator image.
!libs/Software/Linux/Simulator/sim5_linux/devices/

/ext
