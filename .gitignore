# ==============================================================================
# Git Ignore - Micro-HSM (Utimaco Payment HSM & Spring Boot Microservice)
# ==============================================================================

# Compiled binaries and target directory
target/
*.class
*.jar
*.war
*.ear

# Maven Wrapper runtime cache
.mvn/wrapper/maven-wrapper.jar

# IDE & Editor files
.idea/
*.iml
*.iws
*.ipr
.vscode/
.settings/
.project
.classpath
.factorypath

# OS metadata & temporary files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.log
*.tmp
*.bak
*.swp
*~

# Exported keys, runtime logs & secrets generated by container
docker/utimaco-sim/exported-keys/*
!docker/utimaco-sim/exported-keys/.gitkeep
exported-keys/*
!exported-keys/.gitkeep

# Utimaco devices runtime memory persistence (NVRAM/SDRAM/FLASH volatile files)
docker/utimaco-sim/devices/
devices/

# Note: The binaries under ext/u.trust-GP-HSM-Simulator_v6.6.0.0/ are REQUIRED
# by docker/utimaco-sim/Dockerfile to build the Utimaco Simulator image.
# Do NOT ignore the Linux simulator binaries (bl_sim5, csadm, p11tool2, libcs_pkcs11_R3.so).

/ext
